# Copy non-public credentials into .env. The actual .env file is ignored by Git.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=voice_over_video
# Local mode skips registration/login and uses one local workspace user.
# Set AUTH_MODE=account to restore email/password login.
AUTH_MODE=local
LOCAL_USER_ID=1
LOCAL_USER_EMAIL=local@voice-over-video.local
LOCAL_USER_NAME=本地工作台
# Faster-Whisper shares runtime/python with the backend in the portable package.
# Leave ASR_PYTHON unset so the currently running portable Python is used.
ASR_DEVICE=auto
ASR_MODEL=base
ASR_LANGUAGE=zh
# Official IndexTTS2 source and models live under tools/IndexTTS2. Python dependencies
# are installed once in runtime/python so the whole folder can be moved as a unit.
INDEXTTS2_ROOT=tools/IndexTTS2
INDEXTTS2_MODEL_DIR=tools/IndexTTS2/checkpoints
INDEXTTS2_DEFAULT_VOICE=voice_05.wav
INDEXTTS2_DEVICE=cuda:0
INDEXTTS2_FP16=true
INDEXTTS2_EMOTION_WEIGHT=0.65
# Optional cluster GPU service. Leave CLOUD_API_BASE_URL blank to keep the
# cluster mode disabled. Tokens are kept only in backend memory, never in the
# browser or this file.
# Production gateway: https://oneclickvidgen.com/api/v1
CLOUD_API_BASE_URL=
CLOUD_API_CONNECT_TIMEOUT=15
CLOUD_API_READ_TIMEOUT=180
CLOUD_API_RETRY_COUNT=2
CLOUD_API_RETRY_DELAY_SECONDS=1
CLOUD_JOB_POLL_INTERVAL=2
CLOUD_JOB_MAX_WAIT_SECONDS=3600
GEMINI_API_KEY=
# Agent language provider. Selectable from the UI: gemini, deepseek, openai, kimi, glm.
# Existing RunningHub / OpenAI-compatible Gemini setups stay available as runninghub.
# Each provider retains its own key when you switch, so keys are never overwritten.
LANGUAGE_PROVIDER=gemini
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
MOONSHOT_API_KEY=
MOONSHOT_API_BASE=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.5
ZAI_API_KEY=
ZAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZAI_MODEL=glm-4.7-flash
# Optional universal key. Saving it from the UI fills blank language/image fields.
APP_COMMON_API_KEY=
# Optional additional common RunningHub-style accounts, comma-separated.
# APP_COMMON_API_KEYS=key_2,key_3
# Optional Qwen-TTS (DashScope / Alibaba Cloud Model Studio) key.
DASHSCOPE_API_KEY=
GEMINI_PROVIDER=google
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Optional: comma-separated fallback models used when Gemini returns 429/5xx.
GEMINI_FALLBACK_MODELS=
GEMINI_RETRY_COUNT=3
GEMINI_RETRY_DELAY_SECONDS=3
# The two story agents are file-backed: Agent 1 writes story_plan.json and
# Agent 2 writes visual_prompt_plan.json plus the compatible poster_mapping.json.
# Resume mode reuses plans only when their source fingerprint still matches.
# Texts over this many characters use hierarchical planning: one full-text bible
# plus one constrained local plan per video segment. Shorter texts stay lightweight.
AGENT_HIERARCHICAL_MIN_CHARS=6000
# For OpenAI-compatible relays such as RunningHub LLM:
# GEMINI_PROVIDER=runninghub
# GEMINI_API_BASE=https://llm.runninghub.ai/v1
# GEMINI_MODEL=google/gemini-3.1-flash-lite-preview
# GEMINI_REASONING_EFFORT=none
# GEMINI_MAX_TOKENS=8192
# GEMINI_TOP_P=1
# GEMINI_PRESENCE_PENALTY=0
# GEMINI_FREQUENCY_PENALTY=0
RUNNINGHUB_API_KEY=
# Standard Model APIs require keys that RunningHub permits for Enterprise-Shared access.
# Optional account pool: set numbered keys or a comma-separated RUNNINGHUB_API_KEYS.
# The next account is used automatically when the current account returns 414.
RUNNINGHUB_API_KEY_2=
RUNNINGHUB_API_KEY_3=
# RUNNINGHUB_API_KEYS=key_1,key_2,key_3
# RunningHub image generation endpoint:
# https://www.runninghub.cn/openapi/v2/rhart-image-g-2/text-to-image
RUNNINGHUB_ENDPOINT=/rhart-image-g-2/text-to-image
RUNNINGHUB_RESOLUTION=1k
RUNNINGHUB_TARGET_RATIO=2:1
# Local worker concurrency. RunningHub 421 responses enter the local queue and
# are retried when the platform reports a queue change.
RUNNINGHUB_ACTIVE_TASK_CONCURRENCY=3
RUNNINGHUB_IMAGE_MAX_WAIT_SECONDS=1200
RUNNINGHUB_RETRY_DELAY_SECONDS=8
RUNNINGHUB_SUBMIT_MAX_ATTEMPTS=90
RUNNINGHUB_RESULT_MAX_RETRIES=8
RUNNINGHUB_MODERATION_MAX_RETRIES=3
RUNNINGHUB_ALLOW_NEIGHBOR_FALLBACK=1
RUNNINGHUB_QUEUE_POLL_SECONDS=5
RUNNINGHUB_QUEUE_MAX_WAIT_SECONDS=1800
RUNNINGHUB_QUEUE_PROBE_SECONDS=30
# Hyperframes video rendering. "auto" selects workers from available CPU/RAM.
# GPU encoding is probed at runtime and safely falls back to CPU when unavailable.
VIDEO_RENDER_WORKERS=auto
VIDEO_RENDER_GPU_ENCODING=1
VIDEO_RENDER_BROWSER_GPU=auto
VIDEO_RENDER_FPS=30
VIDEO_RENDER_QUALITY=standard
DB_BACKEND=sqlite
SQLITE_PATH=runtime_logs/app.sqlite3
