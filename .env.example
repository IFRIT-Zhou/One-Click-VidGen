# Copy non-public credentials into .env. The actual .env file is ignored by Git.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=voice_over_video
# Faster-Whisper can use a separate Conda/Python environment from the backend.
# When unset, the backend checks its own Python and the local pytorch2.11 environment.
# ASR_PYTHON=/home/hy/miniconda3/envs/pytorch2.11/bin/python
ASR_DEVICE=auto
ASR_MODEL=base
ASR_LANGUAGE=zh
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Optional: comma-separated fallback models used when Gemini returns 429/5xx.
GEMINI_FALLBACK_MODELS=
GEMINI_RETRY_COUNT=3
GEMINI_RETRY_DELAY_SECONDS=3
RUNNINGHUB_API_KEY=
# Standard Model APIs require keys that RunningHub permits for Enterprise-Shared access.
# Optional account pool: set numbered keys or a comma-separated RUNNINGHUB_API_KEYS.
# The next account is used automatically when the current account returns 414.
RUNNINGHUB_API_KEY_2=
RUNNINGHUB_API_KEY_3=
# RUNNINGHUB_API_KEYS=key_1,key_2,key_3
# Narration provider. RUNNINGHUB_TTS_API_KEY can override the shared key above.
RUNNINGHUB_TTS_ENABLED=true
# RUNNINGHUB_TTS_API_KEY=
RUNNINGHUB_TTS_ENDPOINT=/openapi/v2/rhart-audio/text-to-audio/speech-2.8-hd
RUNNINGHUB_TTS_QUERY_ENDPOINT=/openapi/v2/query
RUNNINGHUB_TTS_VOICE_ID=Wise_Woman
RUNNINGHUB_TTS_SPEED=1
RUNNINGHUB_TTS_VOLUME=1
RUNNINGHUB_TTS_PITCH=0
# Optional, for example happy/sad; blank lets the model use its default.
RUNNINGHUB_TTS_EMOTION=
# Optional single pronunciation rule, for example ASAP/As soon as possible.
RUNNINGHUB_TTS_PRONUNCIATION=
RUNNINGHUB_TTS_ENGLISH_NORMALIZATION=false
RUNNINGHUB_TTS_POLL_SECONDS=1
RUNNINGHUB_TTS_MAX_WAIT_SECONDS=300
RUNNINGHUB_TTS_REQUEST_ATTEMPTS=3
# Audio downloads retry with Requests; TLS failures automatically fall back to
# system curl while keeping certificate verification enabled.
RUNNINGHUB_TTS_DOWNLOAD_BACKEND=auto
# The COS result CDN is normally faster and more stable when it bypasses a
# desktop HTTP/SOCKS proxy. Set false if the host can only reach it by proxy.
RUNNINGHUB_TTS_CURL_BYPASS_PROXY=true
# RunningHub image generation endpoint:
# https://www.runninghub.cn/openapi/v2/rhart-image-g-2/text-to-image
RUNNINGHUB_ENDPOINT=/rhart-image-g-2/text-to-image
RUNNINGHUB_RESOLUTION=1k
RUNNINGHUB_TARGET_RATIO=16:9
# Local worker concurrency. RunningHub 421 responses enter the local queue and
# are retried when the platform reports a queue change.
RUNNINGHUB_ACTIVE_TASK_CONCURRENCY=1
RUNNINGHUB_RETRY_DELAY_SECONDS=8
RUNNINGHUB_SUBMIT_MAX_ATTEMPTS=90
RUNNINGHUB_QUEUE_POLL_SECONDS=5
RUNNINGHUB_QUEUE_MAX_WAIT_SECONDS=1800
RUNNINGHUB_QUEUE_PROBE_SECONDS=30
