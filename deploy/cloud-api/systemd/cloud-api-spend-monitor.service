[Unit]
Description=OCV upstream actual spend USD 20 email reminders
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cloudapi
Group=cloudapi
WorkingDirectory=/opt/cloud-api
EnvironmentFile=/etc/cloud-api.env
EnvironmentFile=-/etc/cloud-api-ican.env
EnvironmentFile=-/etc/cloud-api-smtp.env
EnvironmentFile=-/etc/cloud-api-spend-monitor.env
ExecStart=/opt/cloud-api/.venv/bin/python -m app.pool_spend_runner
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cloud-api
TimeoutStartSec=600
